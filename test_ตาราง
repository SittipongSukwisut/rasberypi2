    if region is None:

        return


    y1 = (
        roi_y1
        +
        region[0]
    )


    y2 = (
        roi_y1
        +
        region[1]
    )


    cv2.rectangle(
        frame,

        (
            roi_x1,
            y1
        ),

        (
            ROI_X2,
            y2
        ),

        color,

        2
    )


    cv2.putText(
        frame,

        name,

        (
            roi_x1 + 10,
            y1 + 25
        ),

        cv2.FONT_HERSHEY_SIMPLEX,

        0.7,

        color,

        2
    )


