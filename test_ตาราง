# ============================================================
#                  ULTRASONIC FUNCTION
# ============================================================

def measure_distance():

    """
    วัดระยะจาก Ultrasonic
    ผลลัพธ์เป็น cm

    ถ้าวัดไม่ได้จะคืนค่า None
    """

    # --------------------------------------------------------
    # ส่ง Pulse 10 microseconds
    # --------------------------------------------------------

    GPIO.output(
        TRIG_PIN,
        GPIO.LOW
    )

    time.sleep(
        0.000002
    )

    GPIO.output(
        TRIG_PIN,
        GPIO.HIGH
    )

    time.sleep(
        0.00001
    )

    GPIO.output(
        TRIG_PIN,
        GPIO.LOW
    )


    # --------------------------------------------------------
    # รอ ECHO HIGH
    # --------------------------------------------------------

    timeout_start = time.perf_counter()

    while GPIO.input(ECHO_PIN) == 0:

        if (
            time.perf_counter()
            -
            timeout_start
            >
            0.03
        ):

            return None


    pulse_start = time.perf_counter()


    # --------------------------------------------------------
    # รอ ECHO LOW
    # --------------------------------------------------------

    timeout_start = time.perf_counter()

    while GPIO.input(ECHO_PIN) == 1:

        if (
            time.perf_counter()
            -
            timeout_start
            >
            0.03
        ):

            return None


    pulse_end = time.perf_counter()


    # --------------------------------------------------------
    # คำนวณเวลาที่เสียงเดินทาง
    # --------------------------------------------------------

    pulse_duration = (
        pulse_end
        -
        pulse_start
    )


    # --------------------------------------------------------
    # คำนวณระยะ
    #
    # ระยะ = เวลา × ความเร็วเสียง / 2
    #
    # --------------------------------------------------------

    distance_cm = (
        pulse_duration
        *
        SOUND_SPEED_CM
        /
        2
    )


    # --------------------------------------------------------
    # ตรวจสอบระยะ
    # --------------------------------------------------------

    if (
        distance_cm <= 0
        or
        distance_cm > MAX_DISTANCE_CM
    ):

        return None


    return distance_cm


# ============================================================
#                  DETECT GROOVES
# ============================================================

def detect_grooves(roi):


    gray = cv2.cvtColor(
        roi,
        cv2.COLOR_BGR2GRAY
    )


    gray = cv2.GaussianBlur(
        gray,
        (5, 5),
        0
    )


    sobel_y = cv2.Sobel(
        gray,
        cv2.CV_64F,
        0,
        1,
        ksize=3
    )


    sobel_y = np.abs(
        sobel_y
    )


    profile = np.mean(
        sobel_y,
        axis=1
    )


    profile = cv2.GaussianBlur(
        profile.reshape(-1, 1),
        (1, 15),
        0
    ).flatten()


    threshold = (
        np.mean(profile)
        +
        np.std(profile)
        *
        THRESHOLD_FACTOR
    )


    candidates = []


    for y in range(
        1,
        len(profile) - 1
    ):

        if profile[y] > threshold:

            if (
                profile[y] >= profile[y - 1]
                and
                profile[y] >= profile[y + 1]
            ):

                candidates.append(
                    y
                )


    grooves = []


    for y in candidates:

        if len(grooves) == 0:

            grooves.append(
                y
            )

            continue


        distance = abs(
            y - grooves[-1]
        )


        if distance >= MIN_GROOVE_DISTANCE:

            grooves.append(
                y
            )

        else:

            old_y = grooves[-1]

            if profile[y] > profile[old_y]:

                grooves[-1] = y


    return grooves, profile


# ============================================================
#                  COLOR MASK
# ============================================================

def create_color_mask(
    hsv,
    lower,
    upper
):


    mask = cv2.inRange(
        hsv,
        lower,
        upper
    )


    kernel = np.ones(
        (5, 5),
        np.uint8
    )


    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        kernel
    )


    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel
    )


    return mask


# ============================================================
#                  COLOR PROFILE
# ============================================================

def get_color_profile(mask):


    profile = np.sum(
        mask > 0,
        axis=1
    )


    return profile


# ============================================================
#                  FIND COLOR REGION
# ============================================================

def find_color_region(mask):


    profile = get_color_profile(
        mask
    )


    width = mask.shape[1]


    minimum_pixels = int(
        width *
        MIN_COLOR_RATIO
    )


    rows = []


    for y in range(
        len(profile)
    ):

        if profile[y] >= minimum_pixels:

            rows.append(
                y
            )


    if len(rows) == 0:

        return None


    regions = []


    start = rows[0]

    previous = rows[0]


    for y in rows[1:]:

        if y - previous <= 3:

            previous = y

        else:

            regions.append(
                (
                    start,
                    previous
                )
            )

            start = y

            previous = y


    regions.append(
        (
            start,
            previous
        )
    )


    best_region = None

    best_height = 0


    for y1, y2 in regions:

        height = (
            y2
            -
            y1
            +
            1
        )


        if height > best_height:

            best_height = height

            best_region = (
                y1,
                y2
            )


    if best_region is None:

        return None


    y1, y2 = best_region


    area = np.sum(
        mask[y1:y2 + 1] > 0
    )


    if area < MIN_COLOR_AREA:

        return None


    return (
        y1,
        y2,
        area
    )


# ============================================================
#                  FIND COLORED WOOD
# ============================================================

def find_colored_wood(
    color_region,
    grooves
):


    if color_region is None:

        return None


    color_top = color_region[0]

    color_bottom = color_region[1]


    if len(grooves) >= 2:

        upper_boundary = None

        lower_boundary = None


        for groove in grooves:

            if groove <= color_top:

                upper_boundary = groove


            if (
                groove >= color_bottom
                and
                lower_boundary is None
            ):

                lower_boundary = groove


        if (
            upper_boundary is not None
            and
            lower_boundary is not None
        ):

            return (
                upper_boundary,
                lower_boundary
            )


    return (
        color_top,
        color_bottom
    )


# ============================================================
#                  PIXEL TO MM
# ============================================================

def pixel_to_mm(pixels):

    return (
        pixels
        /
        PIXEL_PER_MM
    )


# ============================================================
#                  CALCULATE BUNDLE HEIGHT
# ============================================================

def calculate_bundle_height(
    grooves,
    roi_height
):


    if len(grooves) < 2:

        return None


    top = grooves[0]

    bottom = grooves[-1]


    pixel_height = (
        bottom
        -
        top
    )


    if pixel_height <= 0:

        return None


    mm = pixel_to_mm(
        pixel_height
    )


    return {
        "top": top,
        "bottom": bottom,
        "pixel": pixel_height,
        "mm": mm
    }


