            frame,

            f"SCALE : {PIXEL_PER_MM:.2f} px/mm",

            (
                20,
                250
            ),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.55,

            (200, 200, 200),

            1
        )


        # ====================================================
        # DISPLAY
        # ====================================================

        cv2.imshow(
            "WOOD BUNDLE",
            frame
        )


        # ====================================================
        # KEY
        # ====================================================

        key = cv2.waitKey(1) & 0xFF


        # ====================================================
        # Q
        # ====================================================

        if key == ord("q"):

            break


        # ====================================================
        # S = SAVE
        # ====================================================

        if key == ord("s"):


            filename = (
                "wood_result_"
                +
                time.strftime(
                    "%Y%m%d_%H%M%S"
                )
                +
                ".jpg"
            )


            cv2.imwrite(
                filename,
                frame
            )


            # =================================================
            # PRINT RESULT
            # =================================================

            print()

            print(
                "=========================================="
            )

            print(
                "             WOOD RESULT"
            )

            print(
                "=========================================="
            )


            print(
                f"จำนวนแผ่น : "
                f"{wood_count} แผ่น"
            )


            print(
                f"จำนวนร่อง : "
                f"{groove_count} ร่อง"
            )


            print()


            # -------------------------------------------------
            # Purple
            # -------------------------------------------------

            if purple_thickness is not None:

                print(
                    f"ไม้สีม่วง : "
                    f"{purple_thickness:.2f} mm"
                )

            else:

                print(
                    "ไม้สีม่วง : ไม่พบ"
                )


            # -------------------------------------------------
            # Yellow
            # -------------------------------------------------

            if yellow_thickness is not None:

                print(
                    f"ไม้สีเหลือง : "
                    f"{yellow_thickness:.2f} mm"
                )

            else:

                print(
                    "ไม้สีเหลือง : ไม่พบ"
                )


            # -------------------------------------------------
            # Bundle
            # -------------------------------------------------

            if bundle is not None:

                print(
                    f"ความสูงห่อทั้งหมด : "
                    f"{bundle['mm']:.2f} mm"
                )

            else:

                print(
                    "ความสูงห่อทั้งหมด : "
                    "ไม่สามารถวัดได้"
                )


            # -------------------------------------------------
            # Ultrasonic
            # -------------------------------------------------

            if distance_cm is not None:

                print(
                    f"ระยะ Ultrasonic : "
                    f"{distance_cm:.2f} cm"
                )

            else:

                print(
                    "ระยะ Ultrasonic : "
                    "ไม่สามารถวัดได้"
                )


            print()


            print(
                f"บันทึกภาพ : "
                f"{filename}"
            )


            print(
                "=========================================="
            )


# ============================================================
#                  ERROR HANDLING
# ============================================================

except KeyboardInterrupt:

    print()

    print(
        "หยุดโปรแกรมด้วย Keyboard"
    )


except Exception as e:

    print()

    print(
        "เกิดข้อผิดพลาด:"
    )

    print(e)


# ============================================================
#                  CLOSE
# ============================================================

finally:

    cv2.destroyAllWindows()

    try:

        picam2.stop()

    except:

        pass


    GPIO.output(
        TRIG_PIN,
        GPIO.LOW
    )

    GPIO.cleanup()


    print()

    print(
        "ปิดโปรแกรมแล้ว"
    )
