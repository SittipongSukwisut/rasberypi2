#                  ULTRASONIC FUNCTION
# ============================================================

def measure_distance():

    GPIO.output(
        TRIG_PIN,
        GPIO.LOW
    )

    time.sleep(0.000002)

    GPIO.output(
        TRIG_PIN,
        GPIO.HIGH
    )

    time.sleep(0.00001)

    GPIO.output(
        TRIG_PIN,
        GPIO.LOW
    )


    # --------------------------------------------------------
    # รอ ECHO HIGH
    # --------------------------------------------------------

    timeout_start = time.perf_counter()

    while GPIO.input(ECHO_PIN) == 0:

        if (
            time.perf_counter()
            -
            timeout_start
            >
            0.03
        ):

            return None


    pulse_start = time.perf_counter()


    # --------------------------------------------------------
    # รอ ECHO LOW
    # --------------------------------------------------------

    timeout_start = time.perf_counter()

    while GPIO.input(ECHO_PIN) == 1:

        if (
            time.perf_counter()
            -
            timeout_start
            >
            0.03
        ):

            return None


    pulse_end = time.perf_counter()


    # --------------------------------------------------------
    # คำนวณ
    # --------------------------------------------------------

    pulse_duration = (
        pulse_end
        -
        pulse_start
    )


    distance_cm = (
        pulse_duration
        *
        SOUND_SPEED_CM
        /
        2
    )


    if (
        distance_cm <= 0
        or
        distance_cm > MAX_DISTANCE_CM
    ):

        return None


    return distance_cm


# ============================================================
#                  ROBUST ULTRASONIC
# ============================================================

def average_distance(
    samples=ULTRASONIC_SAMPLES,
    delay=ULTRASONIC_DELAY
):

    values = []


    # --------------------------------------------------------
    # อ่านหลายครั้ง
    # --------------------------------------------------------

    for i in range(samples):

        value = measure_distance()


        if value is not None:

            # ------------------------------------------------
            # สำคัญ:
            # H = 39.01
            #
            # ค่า h ที่มากกว่า H แทบเป็นไปไม่ได้
            # จึงไม่เอามาคำนวณ
            # ------------------------------------------------

            max_valid_h = (
                FIXED_FLOOR_DISTANCE_CM
                -
                ULTRASONIC_SAFETY_MARGIN_CM
            )


            if value <= max_valid_h:

                values.append(value)


        time.sleep(delay)


    # --------------------------------------------------------
    # ไม่มีค่า
    # --------------------------------------------------------

    if not values:

        return None


    # --------------------------------------------------------
    # เรียงค่า
    # --------------------------------------------------------

    values.sort()


    # --------------------------------------------------------
    # หา Median รอบแรก
    # --------------------------------------------------------

    median_value = float(
        np.median(values)
    )


    # --------------------------------------------------------
    # ตัดค่าที่หลุดจาก Median
    # --------------------------------------------------------

    filtered_values = []


    for value in values:

        if (
            abs(
                value
                -
                median_value
            )
            <=
            ULTRASONIC_MAX_DEVIATION_CM
        ):

            filtered_values.append(value)


    # --------------------------------------------------------
    # ถ้ากรองแล้วไม่มีค่า
    # ใช้ Median เดิม
    # --------------------------------------------------------

    if not filtered_values:

        filtered_values = values


    # --------------------------------------------------------
    # Median สุดท้าย
    # --------------------------------------------------------

    result = float(
        np.median(
            filtered_values
        )
    )


    # --------------------------------------------------------
    # DEBUG
    # --------------------------------------------------------

    print()
    print(
        "Ultrasonic samples:",
        len(values)
    )

    print(
        "Valid samples:",
        len(filtered_values)
    )

    print(
        "h values:",
        [
            round(v, 2)
            for v in filtered_values
        ]
    )

    print(
        f"Median h = {result:.2f} cm"
    )


    return result


