# ============================================================
#                  DETECT GROOVES
# ============================================================

def detect_grooves(roi):

    gray = cv2.cvtColor(
        roi,
        cv2.COLOR_BGR2GRAY
    )


    gray = cv2.GaussianBlur(
        gray,
        (5, 5),
        0
    )


    sobel_y = cv2.Sobel(
        gray,
        cv2.CV_64F,
        0,
        1,
        ksize=3
    )


    sobel_y = np.abs(
        sobel_y
    )


    profile = np.mean(
        sobel_y,
        axis=1
    )


    profile = cv2.GaussianBlur(
        profile.reshape(-1, 1),
        (1, 15),
        0
    ).flatten()


    threshold = (
        np.mean(profile)
        +
        np.std(profile)
        *
        THRESHOLD_FACTOR
    )


    candidates = []


    for y in range(
        1,
        len(profile) - 1
    ):

        if profile[y] > threshold:

            if (
                profile[y] >= profile[y - 1]
                and
                profile[y] >= profile[y + 1]
            ):

                candidates.append(y)


    grooves = []


    for y in candidates:

        if len(grooves) == 0:

            grooves.append(y)

            continue


        distance = abs(
            y - grooves[-1]
        )


        if distance >= MIN_GROOVE_DISTANCE:

            grooves.append(y)

        else:

            old_y = grooves[-1]

            if profile[y] > profile[old_y]:

                grooves[-1] = y


    return grooves, profile


# ============================================================
#                  PIXEL -> MM
# ============================================================

def pixel_to_mm(pixels):

    return (
        pixels /
        PIXEL_PER_MM
    )


# ============================================================
#                  CALCULATE THICKNESS
# ============================================================

def calculate_thickness(grooves):

    thickness_list = []


    if len(grooves) < 2:

        return thickness_list


    for i in range(
        1,
        len(grooves)
    ):

        pixel_thickness = (
            grooves[i]
            -
            grooves[i - 1]
        )


        if pixel_thickness <= 0:

            continue


        mm_thickness = (
            pixel_to_mm(
                pixel_thickness
            )
        )


        thickness_list.append({

            "index":
                i,

            "pixel":
                pixel_thickness,

            "mm":
                mm_thickness

        })


    return thickness_list


# ============================================================
#                  CALCULATE BUNDLE
# ============================================================

def calculate_bundle_height(
    grooves,
    roi_height
):

    if len(grooves) < 2:

        return None


    top = grooves[0]

    bottom = grooves[-1]


    pixel_height = (
        bottom
        -
        top
    )


    if pixel_height <= 0:

        return None


    mm = pixel_to_mm(
        pixel_height
    )


    return {

        "top":
            top,

        "bottom":
            bottom,

        "pixel":
            pixel_height,

        "mm":
            mm

    }


